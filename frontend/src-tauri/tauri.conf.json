{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AI Attendance Agent",
  "version": "1.0.0",
  "identifier": "com.aiattendance.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AI Attendance Agent",
        "width": 1680,
        "height": 980,
        "minWidth": 1400,
        "minHeight": 900,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../dist/backend": "backend"
    }
  }
}
