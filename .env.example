APP_NAME=AI Attendance Agent
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_attendance_agent
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_attendance_agent

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

LOG_LEVEL=INFO
LOG_FORMAT=plain

BACKEND_CORS_ORIGINS=
TRUSTED_HOSTS=*
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

MIN_WORKING_HOURS=8
MAX_PAYABLE_HOURS=8
OVERTIME_PAID=false
BREAK_DURATION_REQUIRED=true
DEFAULT_WORKING_DAYS_PER_MONTH=26
DEFAULT_MONTHLY_SALARY=30000

ATTENDANCE_PROVIDER=file
UPLOADS_DIR=uploads
REPORTS_DIR=reports

# Local employee directory (salary master). Attendance export still supplies ID/Name/Dept.
EMPLOYEE_DIRECTORY_FILE=sample_data/employees.csv
# true = register employees found in attendance exports (recommended for production HRMS exports)
# false = ignore attendance rows for employee IDs not already in the database (strict safety mode)
AUTO_REGISTER_EMPLOYEES_FROM_ATTENDANCE=true

NOTIFICATION_PROVIDER=telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TOKEN=
WHATSAPP_GROUP_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_API_VERSION=v19.0
REPORT_TIME=18:30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LATE_ARRIVAL_TIME=09:30
SHORT_WORKDAY_THRESHOLD_HOURS=8
EXTREMELY_SHORT_WORKDAY_HOURS=2
AI_AUTO_NOTIFY=true
