APP_NAME=AI Attendance Agent
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_attendance_agent
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_attendance_agent

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

LOG_LEVEL=INFO
LOG_FORMAT=plain

BACKEND_CORS_ORIGINS=
TRUSTED_HOSTS=*
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json
